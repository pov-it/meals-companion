#include "Shared.xcconfig"

// Applied by the MealsCompanion target. Debug/Release xcconfig at the
// project level still supplies APS_ENVIRONMENT and compiler flags.
PRODUCT_BUNDLE_IDENTIFIER = $(MEALS_BUNDLE_BASE)
PRODUCT_NAME = Meals
INFOPLIST_FILE = MealsCompanion/Info.plist
CODE_SIGN_ENTITLEMENTS = MealsCompanion/MealsCompanion.entitlements
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Meals
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.lifestyle
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
SUPPORTS_MACCATALYST = NO
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
