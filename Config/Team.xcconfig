// Team + bundle identifiers for Meals Companion.
//
// Replace TEAMID with your 10-character Apple Developer Team ID
// (Apple Developer → Membership → Team ID). The same team will sign
// this app later; this file is a placeholder so the project opens.
//
// Optional: copy to Team.local.xcconfig (gitignored) and include that
// instead if you do not want a team id in git.
//
// Bundle ID pattern (app):     org.pov-it.$(DEVELOPMENT_TEAM).meals
// Bundle ID pattern (widget):  org.pov-it.$(DEVELOPMENT_TEAM).meals.widget
// App Group:                   group.org.pov-it.$(DEVELOPMENT_TEAM).meals
// CloudKit container:          iCloud.org.pov-it.$(DEVELOPMENT_TEAM).meals

DEVELOPMENT_TEAM = TEAMID
