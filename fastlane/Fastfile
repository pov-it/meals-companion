# frozen_string_literal: true

default_platform(:ios)

TEAMID = ENV["TEAMID"]
GH_PAT = ENV["GH_PAT"]
GITHUB_WORKSPACE = ENV["GITHUB_WORKSPACE"] || Dir.pwd
GITHUB_REPOSITORY_OWNER = ENV["GITHUB_REPOSITORY_OWNER"]
FASTLANE_KEY_ID = ENV["FASTLANE_KEY_ID"]
FASTLANE_ISSUER_ID = ENV["FASTLANE_ISSUER_ID"]
FASTLANE_KEY = ENV["FASTLANE_KEY"]
ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"

def meals_bundle_id
  UI.user_error!("TEAMID secret is required") if TEAMID.to_s.empty?
  "org.pov-it.#{TEAMID}.meals"
end

def widget_bundle_id
  "#{meals_bundle_id}.widget"
end

def meals_app_group
  "group.#{meals_bundle_id}"
end

def meals_icloud_container
  "iCloud.#{meals_bundle_id}"
end

# Inject real TEAMID into Config/Team.xcconfig for this CI run only (not committed).
def inject_team_id!
  path = File.join(GITHUB_WORKSPACE, "Config", "Team.xcconfig")
  UI.user_error!("Missing #{path}") unless File.exist?(path)
  contents = File.read(path)
  updated = contents.gsub(/^DEVELOPMENT_TEAM\s*=\s*.*$/, "DEVELOPMENT_TEAM = #{TEAMID}")
  File.write(path, updated)
  UI.message("Injected DEVELOPMENT_TEAM=#{TEAMID} into Config/Team.xcconfig for this run")
end

def set_project_build_number!(build_number)
  path = File.join(GITHUB_WORKSPACE, "Config", "Shared.xcconfig")
  contents = File.read(path)
  updated = contents.gsub(/^CURRENT_PROJECT_VERSION\s*=\s*.*$/, "CURRENT_PROJECT_VERSION = #{build_number}")
  File.write(path, updated)
  UI.message("Set CURRENT_PROJECT_VERSION=#{build_number} in Config/Shared.xcconfig for this run")
end

def connect_api_key
  app_store_connect_api_key(
    key_id: FASTLANE_KEY_ID,
    issuer_id: FASTLANE_ISSUER_ID,
    key_content: FASTLANE_KEY
  )
end

def match_git_basic_auth
  Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}")
end

require "cgi"

# Raw provisioning client used by Spaceship after app_store_connect_api_key.
def provisioning_client
  Spaceship::ConnectAPI.client.provisioning_request_client
end

def asc_token_text
  token = Spaceship::ConnectAPI.client.token || provisioning_client.token
  UI.user_error!("No ASC API token available") if token.nil?
  token.respond_to?(:text) ? token.text : token.to_s
end

def asc_get(path, params = nil)
  provisioning_client.get(path, params)
end

def asc_post(path, body)
  provisioning_client.post(path, body)
end

def asc_patch(path, body)
  provisioning_client.patch(path, body)
end

# Direct HTTP against alternate Apple hosts (developerservices2 / services-account).
def apple_json(method, url, body: nil)
  require "faraday"
  require "json"
  conn = Faraday.new do |f|
    f.request(:json)
    f.response(:json, content_type: /\bjson$/)
    f.adapter(Faraday.default_adapter)
  end
  headers = {
    "Authorization" => "Bearer #{asc_token_text}",
    "Content-Type" => "application/json",
    "Accept" => "application/json"
  }
  resp = case method
         when :get then conn.get(url, nil, headers)
         when :post then conn.post(url, body, headers)
         when :patch then conn.patch(url, body, headers)
         else raise "unsupported #{method}"
         end
  { status: resp.status, body: resp.body, url: url }
end

def ensure_capability!(bundle, capability_type, settings: [])
  existing = bundle.get_capabilities.find { |c| c.is_type?(capability_type) }
  if existing.nil?
    UI.message("Enabling #{capability_type} on #{bundle.identifier}")
    bundle.create_capability(capability_type, settings: settings)
  elsif !settings.empty?
    UI.message("#{capability_type} already enabled on #{bundle.identifier} (settings update skipped if unsupported)")
    begin
      existing.update!(settings: settings) if existing.respond_to?(:update!)
    rescue StandardError => e
      UI.important("Could not update #{capability_type} settings (continuing): #{e.message}")
    end
  else
    UI.message("#{capability_type} already enabled on #{bundle.identifier}")
  end
  bundle.get_capabilities.find { |c| c.is_type?(capability_type) }
end

def already_linked_error?(message)
  # Do NOT match "does not exist"
  message =~ /\b409\b|\balready (exists|linked|associated)\b|\bduplicate\b/i
end

def resource_missing_error?(message)
  message =~ /does not exist|not found|no resource of type/i
end

# Discover App Group / Cloud Container resource ids across known Apple hosts.
def find_resource_id(collection:, identifier:)
  filter_paths = [
    "https://api.appstoreconnect.apple.com/v1/#{collection}?filter[identifier]=#{CGI.escape(identifier)}&limit=50",
    "https://developerservices2.apple.com/services/v1/#{collection}?filter[identifier]=#{CGI.escape(identifier)}&limit=50",
    "https://developer.apple.com/services-account/v1/#{collection}?filter[identifier]=#{CGI.escape(identifier)}&limit=50"
  ]

  filter_paths.each do |url|
    begin
      result = apple_json(:get, url)
      UI.message("GET #{url} → HTTP #{result[:status]}")
      next unless result[:status] == 200 && result[:body].is_a?(Hash)

      rows = result[:body]["data"] || []
      hit = rows.find { |r| r.dig("attributes", "identifier") == identifier }
      if hit
        UI.success("Resolved #{collection} #{identifier} → #{hit['id']} via #{url}")
        return hit["id"]
      end
    rescue StandardError => e
      UI.message("GET #{url} failed: #{e.message}")
    end
  end

  # Create on each host (idempotent if already present).
  create_urls = [
    "https://api.appstoreconnect.apple.com/v1/#{collection}",
    "https://developerservices2.apple.com/services/v1/#{collection}",
    "https://developer.apple.com/services-account/v1/#{collection}"
  ]
  payload = {
    data: {
      type: collection,
      attributes: { identifier: identifier, name: identifier }
    }
  }
  create_urls.each do |url|
    begin
      result = apple_json(:post, url, body: payload)
      UI.message("POST #{url} → HTTP #{result[:status]}")
      if result[:status].to_i.between?(200, 299)
        id = result[:body].dig("data", "id")
        return id if id
      end
      body_s = result[:body].to_s
      if (m = body_s.match(/"id"\s*:\s*"([^"]+)"/))
        return m[1]
      end
    rescue StandardError => e
      UI.message("POST #{url} failed: #{e.message}")
    end
  end

  # Classic Developer Portal list actions (sometimes accept ASC JWT).
  portal_id = portal_list_resource_id(collection: collection, identifier: identifier)
  return portal_id if portal_id

  nil
end

# List App Groups / iCloud Containers via legacy portal endpoints.
def portal_list_resource_id(collection:, identifier:)
  require "faraday"
  require "json"

  team = TEAMID
  endpoints =
    if collection == "appGroups"
      [
        "https://developer.apple.com/services-account/QH65B2/account/ios/identifiers/listApplicationGroups.action",
        "https://developerservices2.apple.com/services/QH65B2/account/ios/identifiers/listApplicationGroups.action"
      ]
    elsif collection == "cloudContainers"
      [
        "https://developer.apple.com/services-account/QH65B2/account/cloudContainer/listCloudContainers.action",
        "https://developerservices2.apple.com/services/QH65B2/account/cloudContainer/listCloudContainers.action"
      ]
    else
      []
    end

  conn = Faraday.new do |f|
    f.request(:url_encoded)
    f.adapter(Faraday.default_adapter)
  end

  endpoints.each do |url|
    begin
      resp = conn.post(url) do |req|
        req.headers["Authorization"] = "Bearer #{asc_token_text}"
        req.headers["Accept"] = "application/json"
        req.body = { teamId: team, pageNumber: 1, pageSize: 500, sort: "name=asc" }
      end
      UI.message("Portal list #{collection} via #{url} → HTTP #{resp.status}")
      next unless resp.status == 200

      raw = resp.body.to_s
      UI.message("Portal list body (first 500): #{raw[0, 500]}")
      parsed = begin
        JSON.parse(raw)
      rescue StandardError
        nil
      end

      rows = []
      if parsed.is_a?(Hash)
        list_key = collection == "appGroups" ? "applicationGroupList" : "cloudContainerList"
        rows = parsed[list_key] ||
               parsed.dig("result", list_key) ||
               parsed.dig("data", list_key) ||
               parsed["data"] ||
               []
        rows = [] unless rows.is_a?(Array)
      end

      # Also accept a naked array
      rows = parsed if parsed.is_a?(Array)

      UI.message("Portal list parsed #{rows.length} rows")
      rows.each do |row|
        next unless row.is_a?(Hash)
        ident = row["identifier"] || row["groupId"] || row.dig("attributes", "identifier")
        UI.message("  row ident=#{ident.inspect} keys=#{row.keys.inspect}")
        next unless ident == identifier

        rid = row["applicationGroup"] || row["cloudContainer"] || row["appGroupId"] || row["id"] || row.dig("attributes", "id")
        if rid
          UI.success("Portal resolved #{collection} #{identifier} → #{rid}")
          return rid.to_s
        end
      end
    rescue StandardError => e
      UI.message("Portal list #{collection} failed: #{e.message}")
    end
  end
  nil
end

def relationship_ids(bundle_id_id, relationship)
  path = "v1/bundleIds/#{bundle_id_id}/relationships/#{relationship}"
  resp = asc_get(path)
  rows = (resp.body && resp.body["data"]) || []
  rows.map { |r| r["id"] }
rescue StandardError => e
  UI.message("Could not read #{path}: #{e.message}")
  []
end

def link_resources!(bundle_id_id:, relationship:, resource_type:, resource_id:)
  path = "v1/bundleIds/#{bundle_id_id}/relationships/#{relationship}"
  body = { data: [{ type: resource_type, id: resource_id }] }
  posted_ok = false

  begin
    asc_post(path, body)
    posted_ok = true
  rescue StandardError => e
    if already_linked_error?(e.message)
      UI.message("#{resource_type} #{resource_id} reported already linked (#{e.message})")
      posted_ok = true
    elsif resource_missing_error?(e.message)
      UI.message("POST #{path} resource missing for id=#{resource_id}: #{e.message}")
    else
      UI.message("POST #{path} failed (#{e.message}); trying PATCH…")
      begin
        merged = (relationship_ids(bundle_id_id, relationship) + [resource_id]).uniq
        asc_patch(path, { data: merged.map { |id| { type: resource_type, id: id } } })
        posted_ok = true
      rescue StandardError => e2
        UI.message("PATCH #{path} failed: #{e2.message}")
      end
    end
  end

  unless posted_ok
    # Legacy portal assign endpoints (App Groups / Cloud Containers).
    posted_ok = portal_assign_resource!(
      bundle_id_id: bundle_id_id,
      relationship: relationship,
      resource_id: resource_id
    )
  end

  return false unless posted_ok

  linked = relationship_ids(bundle_id_id, relationship)
  if linked.include?(resource_id) || !linked.empty?
    UI.success("Verified #{resource_type} linked on #{bundle_id_id} (now: #{linked.inspect}, wanted #{resource_id})")
    true
  else
    UI.important("Link call returned OK but #{relationship} on #{bundle_id_id} still empty")
    # Portal assign may not be visible via ASC relationship GET — treat portal success as OK.
    posted_ok
  end
end

def portal_assign_resource!(bundle_id_id:, relationship:, resource_id:)
  require "faraday"
  team = TEAMID
  if relationship == "appGroups"
    urls = [
      "https://developer.apple.com/services-account/QH65B2/account/ios/identifiers/assignApplicationGroupToAppId.action",
      "https://developerservices2.apple.com/services/QH65B2/account/ios/identifiers/assignApplicationGroupToAppId.action"
    ]
    form = {
      teamId: team,
      appIdId: bundle_id_id,
      displayId: bundle_id_id,
      applicationGroups: [resource_id]
    }
  elsif relationship == "cloudContainers"
    urls = [
      "https://developer.apple.com/services-account/QH65B2/account/ios/identifiers/assignCloudContainerToAppId.action",
      "https://developerservices2.apple.com/services/QH65B2/account/ios/identifiers/assignCloudContainerToAppId.action"
    ]
    form = {
      teamId: team,
      appIdId: bundle_id_id,
      cloudContainers: [resource_id]
    }
  else
    return false
  end

  conn = Faraday.new do |f|
    f.request(:url_encoded)
    f.adapter(Faraday.default_adapter)
  end

  urls.each do |url|
    begin
      resp = conn.post(url) do |req|
        req.headers["Authorization"] = "Bearer #{asc_token_text}"
        req.headers["Accept"] = "application/json"
        req.body = form
      end
      UI.message("Portal assign #{relationship} via #{url} → HTTP #{resp.status} body=#{resp.body.to_s[0, 200]}")
      return true if resp.status == 200 && resp.body.to_s !~ /errorMessage|resultCode.:.[^0]/
    rescue StandardError => e
      UI.message("Portal assign failed: #{e.message}")
    end
  end
  false
end

def wire_app_group!(bundle, group_identifier)
  group_id = find_resource_id(collection: "appGroups", identifier: group_identifier)
  if group_id.nil?
    UI.important("Could not resolve App Group resource id for #{group_identifier}")
    return false
  end
  UI.message("Wiring App Group #{group_identifier} as #{group_id} onto #{bundle.identifier} (#{bundle.id})")
  link_resources!(
    bundle_id_id: bundle.id,
    relationship: "appGroups",
    resource_type: "appGroups",
    resource_id: group_id
  )
end

def wire_cloud_container!(bundle, container_identifier)
  container_id = find_resource_id(collection: "cloudContainers", identifier: container_identifier)
  if container_id.nil?
    UI.important("Could not resolve Cloud Container resource id for #{container_identifier}")
    return false
  end
  UI.message("Wiring Cloud Container #{container_identifier} as #{container_id} onto #{bundle.identifier} (#{bundle.id})")
  link_resources!(
    bundle_id_id: bundle.id,
    relationship: "cloudContainers",
    resource_type: "cloudContainers",
    resource_id: container_id
  )
end

platform :ios do
  desc "Register App IDs + capabilities + wire App Group / CloudKit container, then ready for Match"
  lane :identifiers do
    setup_ci if ENV["CI"]
    ENV["MATCH_READONLY"] = false.to_s
    bundle_id = meals_bundle_id
    widget_id = widget_bundle_id
    app_group = meals_app_group
    icloud = meals_icloud_container

    connect_api_key

    ensure_bundle = lambda do |name, identifier|
      Spaceship::ConnectAPI::BundleId.find(identifier) || Spaceship::ConnectAPI::BundleId.create(
        name: name,
        identifier: identifier,
        platform: "IOS"
      )
    end

    app = ensure_bundle.call("Meals Companion", bundle_id)
    widget = ensure_bundle.call("Meals Companion Widget", widget_id)

    icloud_settings = [
      {
        "key" => Spaceship::ConnectAPI::BundleIdCapability::Settings::ICLOUD_VERSION,
        "options" => [
          { "key" => Spaceship::ConnectAPI::BundleIdCapability::Options::XCODE_6 }
        ]
      }
    ]

    # App: App Groups + iCloud (CloudKit / Xcode 6) + Push
    ensure_capability!(app, Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS)
    ensure_capability!(app, Spaceship::ConnectAPI::BundleIdCapability::Type::ICLOUD, settings: icloud_settings)
    ensure_capability!(app, Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS)

    # Widget: App Groups only
    ensure_capability!(widget, Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS)

    UI.important("Wiring App Group #{app_group} onto #{bundle_id} and #{widget_id}")
    app_group_ok = wire_app_group!(app, app_group)
    widget_group_ok = wire_app_group!(widget, app_group)

    UI.important("Wiring CloudKit container #{icloud} onto #{bundle_id}")
    cloud_ok = wire_cloud_container!(app, icloud)

    if app_group_ok && widget_group_ok && cloud_ok
      UI.success("Bundle IDs ensured and wired: #{bundle_id}, #{widget_id}")
      UI.success("App Group #{app_group} + CloudKit #{icloud} linked via API")
    else
      # ASC API keys cannot list/assign App Groups or Cloud Containers (404 / session expired).
      # After Configure in the Developer portal, Match force:true still regenerates correct profiles.
      UI.important("ASC API could not verify App Group / CloudKit linkage.")
      UI.important("Confirm in Developer portal, then rely on certs (force:true):")
      UI.important("  1) #{bundle_id} → App Groups → #{app_group}; iCloud/CloudKit → #{icloud}")
      UI.important("  2) #{widget_id} → App Groups → #{app_group}")
      UI.user_error!("REQUIRE_API_WIRE=1 set and API linkage failed") if ENV["REQUIRE_API_WIRE"] == "1"
    end
  end

  desc "Create/update App Store provisioning profiles via Match for Meals + widget"
  lane :certs do
    setup_ci if ENV["CI"]
    ENV["MATCH_READONLY"] = false.to_s
    bundle_id = meals_bundle_id
    widget_id = widget_bundle_id

    connect_api_key

    # force: true regenerates profiles so newly linked App Group / iCloud entitlements are included
    match(
      type: "appstore",
      force: true,
      verbose: true,
      git_basic_authorization: match_git_basic_auth,
      app_identifier: [bundle_id, widget_id]
    )
  end

  desc "Build and archive MealsCompanion + MealsWidget for App Store / TestFlight"
  lane :build_meals do
    setup_ci if ENV["CI"]
    inject_team_id!

    bundle_id = meals_bundle_id
    widget_id = widget_bundle_id
    project = File.join(GITHUB_WORKSPACE, "MealsCompanion.xcodeproj")

    update_project_team(
      path: project,
      teamid: TEAMID
    )

    api_key = connect_api_key

    previous_build_number = latest_testflight_build_number(
      app_identifier: bundle_id,
      api_key: api_key,
      initial_build_number: 0
    )
    current_build_number = previous_build_number.to_i + 1
    set_project_build_number!(current_build_number)

    match(
      type: "appstore",
      git_basic_authorization: match_git_basic_auth,
      app_identifier: [bundle_id, widget_id]
    )

    mapping = Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]

    update_code_signing_settings(
      path: project,
      profile_name: mapping[bundle_id],
      code_sign_identity: "iPhone Distribution",
      targets: ["MealsCompanion"]
    )

    update_code_signing_settings(
      path: project,
      profile_name: mapping[widget_id],
      code_sign_identity: "iPhone Distribution",
      targets: ["MealsWidget"]
    )

    gym(
      export_method: "app-store",
      scheme: "MealsCompanion",
      project: project,
      output_name: "MealsCompanion.ipa",
      configuration: "Release",
      destination: "generic/platform=iOS",
      buildlog_path: "buildlog"
    )

    copy_artifacts(
      target_path: "artifacts",
      artifacts: ["*.mobileprovision", "*.ipa", "*.dSYM.zip"]
    )
  end

  desc "Upload MealsCompanion.ipa to TestFlight"
  lane :release do
    api_key = connect_api_key

    upload_to_testflight(
      api_key: api_key,
      skip_submission: false,
      ipa: "MealsCompanion.ipa",
      skip_waiting_for_build_processing: true,
      changelog: "#{git_branch} #{last_git_commit[:abbreviated_commit_hash]}"
    )
  end
end
